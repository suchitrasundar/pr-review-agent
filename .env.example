# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# GitHub App (for the webhook server / production)
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=pick-a-long-random-string
# Paste the whole .pem; on hosting dashboards you can paste it as-is (multi-line)
# or as one line with \n between lines.
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Personal access token (only for local testing with cli.py)
GITHUB_TOKEN=github_pat_...

# --- Optional ---
ANTHROPIC_MODEL=claude-sonnet-5-5
MAX_AGENT_STEPS=12
MAX_DIFF_CHARS=150000
IGNORE_PATTERNS=*.lock,package-lock.json,*.min.js,*.svg,*.png,*.jpg,dist/*,vendor/*
# true = bot may APPROVE / REQUEST_CHANGES; false = comments only (safer)
ALLOW_VERDICTS=false
